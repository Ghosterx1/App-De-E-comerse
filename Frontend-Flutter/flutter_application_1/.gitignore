# Frontend Flutter / Dart

# Archivos temporales y logs locales. No incluye los informes Markdown
# del proyecto: esos documentos son contenido fuente y se versionan.
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Dependencias y metadatos generados por Dart/Flutter Pub.
# pubspec.yaml y pubspec.lock se conservan para poder reproducir dependencias.
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/

# Documentación API generada; doc/api/ no es la documentación fuente del proyecto.
**/doc/api/
**/ios/Flutter/.last_build_id
INFORME-INTEGRACION.md
INFORME-INTEGRACION.MD
INFORME-INTEGRACION.md.txt
INFORME-INTEGRACION.MD.txt

# Compilados de Flutter para Android, iOS, web y escritorio.
/build/

# Reportes y datos de cobertura generados al ejecutar pruebas.
/coverage/

# Archivos de símbolos generados al simbolicar/crashear una compilación.
app.*.symbols

# Mapas generados por la ofuscación de una compilación.
app.*.map.json

# Salidas de compilación Android; los fuentes de android/app permanecen versionados.
/android/app/debug
/android/app/profile
/android/app/release
